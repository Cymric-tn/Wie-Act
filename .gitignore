# secrets: every env file except the placeholder template
.env
.env.*
!.env.example

# environments / tooling
myenv/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# runtime artefacts (cache, metrics, probe logs)
*.sqlite
*.sqlite-journal
*.jsonl
!tests/eval/*.jsonl
recon_summary.json

# data/: only runtime state is ignored; the course docs, exercise bank, glossary and templates are source.
data/*.sqlite
data/*.sqlite-journal
metrics/*.summary.json
_legacy/*.sqlite

# engine service
runtime/

# app (web front end + Node server): runtime state, uploads, dependencies
app/server/data/
app/**/uploads/
app/**/node_modules/
app/client/dist/
app/.dev-logs/

# runtime index moved aside during a FelCloud slot; LaTeX build files
_legacy/index-courses-*/
docs/report/*.aux
docs/report/*.log
docs/report/*.out
