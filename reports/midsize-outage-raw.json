      "excerpts": [
       {
        "chunk_id": "derivee-definition.fr#interpretation-graphique-la-tangente",
        "text": "Le nombre dérivé f'(a) est le coefficient directeur, c'est-à-dire la pente, de la tangente à la courbe de f au point d'abscisse a."
       },
       {
        "chunk_id": "derivee-definition.fr#interpretation-graphique-la-tangente",
        "text": "La tangente est la droite qui touche la courbe en ce point en suivant sa direction."
       },
       {
        "chunk_id": "derivee-definition.fr#interpretation-graphique-la-tangente",
        "text": "L'équation de la tangente au point d'abscisse a est y = f'(a)(x − a) + f(a)."
       }
      ]
     }
    ],
