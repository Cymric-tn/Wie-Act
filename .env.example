# Copy to .env (or point ENV_FILE at another file). Never commit real values.

# --- provider (OpenAI-compatible) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=changeme                       # Ollama ignores it; FelCloud needs the real key

# --- model classes -> names (comma list = in-class preference order) ---
MODEL_COMPACT=llama3.2:3b,qwen2.5:3b       # FelCloud: llama3.2-3b,qwen2.5-3b
MODEL_MIDSIZE=llama3.1:8b                  # FelCloud: llama3.1-8b
MODEL_EMBED=bge-m3                         # FelCloud: unknown, ask organizers

# --- platform limits (client side) ---
RATE_LIMIT_PER_MIN=20                      # sliding window: at most this many sends in any RATE_WINDOW_S
RATE_WINDOW_S=60
RATE_WINDOW_SLACK_S=0.5                    # a send frees its slot this long after the window
EMBED_RATE_LIMIT_PER_MIN=60
EMBED_RATE_WINDOW_S=60
RATE_BURST=20                              # deprecated: only the simulator's own bucket uses it
EMBED_BURST=60                             # deprecated, as RATE_BURST
MAX_CONCURRENT=2
MAX_TOKENS_COMPACT=300
MAX_TOKENS_MIDSIZE=550
OUTPUT_CAP_MODE=both                       # options | max_tokens | both: FelCloud honours only options.num_predict
INPUT_TOKEN_BUDGET=2800                    # estimated prompt tokens, checked before sending
ESTIMATE_CHARS_PER_TOKEN=2.3               # worst measured case (Arabizi 2.31)
CONTEXT_WINDOW=4096                        # FelCloud silently drops the start of a longer prompt
CONTEXT_FILL=0.85                          # estimated prompt + output cap must fit CONTEXT_WINDOW * this
INPUT_TRUNCATION_CHARS_PER_TOKEN=5         # prompt_tokens < prompt chars / this = input cut (degraded input_truncated); 0 = off
REQUEST_TIMEOUT_S=85                       # FelCloud server timeout is 90 s
MAX_RETRY_WAIT_S=30                        # INTERACTIVE: longest stated quota delay it waits for, else degraded with an eta
MAX_RETRY_WAIT_S_BACKGROUND=65             # BACKGROUND: the observed quota delay is 60 s
CONCURRENCY_RETRY_WAIT_S=2                 # a concurrency 429 states 60 s, but the slot frees at once
MAX_ATTEMPTS=4
SATURATION_RETRIES=1                       # then the router falls back to compact
COMPACT_MAX_RETRIES=3                      # compact has no fallback: retry, then a degraded "service_busy"
QUOTA_LOW_THRESHOLD=2                      # local quota tokens below this -> mid-size tasks go compact
MODELS_WITHOUT_JSON_MODE=                  # FelCloud: mistral-7b,qwen2.5-coder-7b (recon)

# --- cache / prompts ---
CACHE_PATH=data/cache.sqlite
CACHE_TTL_DAYS=7
NEGATIVE_CACHE_TTL_S=600                   # explain answer that failed a check: repeats -> fast mode, 0 requests
PROMPTS_DIR=prompts

# --- retrieval (no embedding model on FelCloud -> BM25 by default) ---
RETRIEVER=bm25                             # bm25 | embedding (embedding needs MODEL_EMBED)
DOCS_DIR=data/docs
RAG_INDEX_PATH=data/index/chunks.json      # built by: python -m scripts.index_docs
RAG_TOP_K=2                                # explain: the 2 most relevant chunks after the gate
RAG_MIN_COVERAGE=0.4                       # measured on the eval set: on-topic >= 0.49, off-topic <= 0.28
CHUNK_MAX_TOKENS=300
BUDGET_SAFETY_MARGIN=0.1                   # prompts are assembled within INPUT_TOKEN_BUDGET * (1 - margin)
GLOSSARY_PATH=data/glossary.yaml           # learner terms -> French course terms (empty = off)
GLOSSARY_WEIGHT=0.5                        # glossary course terms vs question terms in retrieval
TERMS_AR_PATH=data/terms_ar.yaml           # Arabic math terms for MSA answers
EXERCISES_PATH=data/exercises/derivees.yaml   # exercise bank (quiz, grading, stored hints)
EXPLAIN_MAX_TOKENS=350
CLASSIFY_MAX_TOKENS=50                     # per-task output caps; HINT 80, GRADE 120, COMPRESS 30, QUIZ_INTRO 60, FRAMING 40
EXPLAIN_FREQUENCY_PENALTY=0.3              # discourages repetition loops; dropped if the provider rejects it
TEMPLATES_PATH=data/templates.yaml         # openers, practice line, generic grading feedback

# --- circuit breaker (mid-size) ---
BREAKER_THRESHOLD=3                        # saturations ...
BREAKER_WINDOW_S=60                        # ... within this window open the breaker
BREAKER_COOLDOWN_S=30                      # then half-open: one probe closes or reopens it

# --- metrics ---
METRICS_PATH=metrics/calls.jsonl

# --- constraint simulator (local dev only) ---
SIMULATE_CONSTRAINTS=true
SIM_LATENCY_COMPACT_S=2,6
SIM_LATENCY_MIDSIZE_S=8,30
SIM_LATENCY_SCALE=1.0
SIM_RATE_PER_MIN=20
SIM_BURST=20
SIM_EMBED_RATE_PER_MIN=60
SIM_EMBED_BURST=60
SIM_MAX_CONCURRENT=2
SIM_MIDSIZE_SLOTS=1
SIM_SATURATION_PROB=0.15
SIM_SATURATION_DIALECT=annex               # annex (503) | litellm (429 all_deployments_in_cooldown)
SIM_COMPACT_SATURATION_PROB=0.0
SIM_TRANSIENT_ERROR_PROB=0.0
SIM_MAX_TOKENS_CEILING=2048
SIM_PROMPT_TOKENS_CEILING=2048
# SIM_SEED=42
